<!-- sections/page_contact_1_row.liquid -->
{{ 'contact-page.css' | asset_url | stylesheet_tag }}
<div class="t4s-container contact-flex">
  {% for block in section.blocks %}
    {% assign bk_stts = block.settings %}
    {% case block.type %}
      {% when 'customer_service' %}
        <div class="contact-zakaznicky_servis contact-box">
          {% render 'contact_customer_service', bk_stts: bk_stts %}
        </div>
      {% when 'store_prague' %}
        <div class="contact-prodejna_v_praze contact-box">
          {% render 'contact_store_prague', bk_stts: bk_stts %}
        </div>
    {% endcase %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Contact page top row",
  "blocks": [
    {
      "type": "customer_service",
      "name": "Customer service",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Zákaznický servis"
        },
        {
          "type": "textarea",
          "id": "rich_text",
          "label": "Text",
          "default": "S čím pomůžeme?"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Telefon",
          "default": "+420 226 111 222"
        },
        {
          "type": "text",
          "id": "phone_url",
          "label": "Telefon bez mezer",
          "default": "+420226111222"
        },
        {
          "type": "text",
          "id": "operation_time",
          "label": "Provozní doba",
          "default": "(pondělí–pátek 8:00–20:00)"
        },
        {
          "type": "text",
          "id": "mail",
          "label": "E-mail",
          "default": "info@ahinsashoes.com"
        },
        {
          "type": "text",
          "id": "mail_url",
          "label": "E-mail do odkazu",
          "default": "info@ahinsashoes.com"
        },
        {
          "type": "text",
          "id": "customer_care",
          "label": "Postarají se",
