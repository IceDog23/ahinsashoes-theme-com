{%- liquid
  assign og_title = page_title
  assign og_url = canonical_url
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
-%}

{%- if request.page_type == 'product' -%}
  {%- assign og_title = seo_title | strip -%}
  {%- assign og_type = 'product' -%}
{%- elsif request.page_type == 'collection' -%}
  {%- assign og_title = seo_title | strip -%}
{%- elsif request.page_type == 'article' -%}
  {%- assign og_title = article.title | strip_html -%}
  {%- assign og_type = 'article' -%}
  {%- assign og_description = article.excerpt_or_content | strip_html -%}
{%- elsif request.page_type == 'password' -%}
  {%- liquid
    assign og_title = shop.name
    assign og_url = shop.url
    assign og_description = shop.description | default: shop.name
  -%}
{%- endif -%}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ og_url }}">

  {%- if template == 'blog' -%}
    {% if request.path == '/blogs/news' %}
      <title>Walk in healthy shoes blog</title>
      <meta name="description" content="Why is it worth wearing shoes that leave your toes free? You’ll be surprised how much healthy footwear affects. Read and find out.">
      <meta property="og:title" content="Walk in healthy shoes blog">
      <meta property="og:description" content="Why is it worth wearing shoes that leave your toes free? You’ll be surprised how much healthy footwear affects. Read and find out.">
    {% endif %}

    {% if request.path == '/blogs/news/tagged/beh' %}
      <title>Play sports in healthy shoes</title>
      <meta name="description" content="Play sports freely and with ease. Put on barefoot shoes and give it your all. Ahinsa shoes were designed for you by musculoskeletal experts.">
      <meta property="og:title" content="Play sports in healthy shoes">
      <meta property="og:description" content="Play sports freely and with ease. Put on barefoot shoes and give it your all. Ahinsa shoes were designed for you by musculoskeletal experts.">
    {% endif %}

    {% if request.path == '/blogs/news/tagged/cviky' %}
      <title>Exercises and advice from physiotherapists</title>
      <meta name="description" content="Learn how to walk properly and solve problems not only with a sore back and feet. Barefoot and Comfort shoes will help you with that.">
      <meta property="og:title" content="Exercises and advice from physiotherapists">
      <meta property="og:description" content="Learn how to walk properly and solve problems not only with a sore back and feet. Barefoot and Comfort shoes will help you with that.">
    {% endif %}

    {% if request.path == '/blogs/news/tagged/panevni-dno' %}
      <title>Forget pelvic floor problems</title>
      <meta name="description" content="Do you have problems that start in the pelvic floor? Try changing your shoes. Put on Ahinsa shoes and reactivate your pelvic floor.">
      <meta property="og:title" content="Forget pelvic floor problems">
      <meta property="og:description" content="Do you have problems that start in the pelvic floor? Try changing your shoes. Put on Ahinsa shoes and reactivate your pelvic floor.">
    {% endif %}

    {% if request.path == '/blogs/news/tagged/tehotenstvi' %}
      <title>What to wear during pregnancy?</title>
      <meta name="description" content="Ease a sore back and give your feet comfortable footwear. In Ahinsa shoes you’ll relieve your body, which takes a beating during pregnancy.">
      <meta property="og:title" content="What to wear during pregnancy?">
      <meta property="og:description" content="Ease a sore back and give your feet comfortable footwear. In Ahinsa shoes you’ll relieve your body, which takes a beating during pregnancy.">
    {% endif %}

    {% if request.path == '/blogs/news/tagged/veganstvi' %}
      <title>The vegan approach of Ahinsa shoes</title>
      <meta name="description" content="We make shoes you’ll walk millions of steps in. We care about sustainability and use vegan materials for healthy shoes. Which ones?">
      <meta property="og:title" content="The vegan approach of Ahinsa shoes">
      <meta property="og:description" content="We make shoes you’ll walk millions of steps in. We care about sustainability and use vegan materials for healthy shoes. Which ones?">
    {% endif %}

    {% if request.path == '/blogs/news/tagged/materialy' %}
      <title>What materials do we make Ahinsa shoes from?</title>
      <meta name="description" content="Walk in shoes made from vegan materials. No animals or the planet suffer when they’re sourced. Enjoy walking in healthy, gentle shoes.">
      <meta property="og:title" content="What materials do we make Ahinsa shoes from?">
      <meta property="og:description" content="Walk in shoes made from vegan materials. No animals or the planet suffer when they’re sourced. Enjoy walking in healthy, gentle shoes.">
    {% endif %}

    {% if request.path == '/blogs/news/tagged/rozhovor' %}
      <title>Interviews on why healthy footwear matters</title>
      <meta name="description" content="How do experts see human health and footwear? Why is it worth investing in healthy shoes? The most qualified people answer.">
      <meta property="og:title" content="Interviews on why healthy footwear matters">
      <meta property="og:description" content="How do experts see human health and footwear? Why is it worth investing in healthy shoes? The most qualified people answer.">
    {% endif %}

    {% if request.path == '/blogs/news/tagged/tipy' %}
      <title>Advice and tips for happy feet</title>
      <meta name="description" content="Want to do the best for your health? We’ll show you how. It all starts with footwear. Why is wearing Ahinsa shoes worth it?">
      <meta property="og:title" content="Advice and tips for happy feet">
      <meta property="og:description" content="Want to do the best for your health? We’ll show you how. It all starts with footwear. Why is wearing Ahinsa shoes worth it?">
    {% endif %}

    {% if request.path == '/blogs/news/tagged/zdrava-chuze' %}
      <title>What does healthy walking affect?</title>
      <meta name="description" content="Did you know healthy shoes can help with musculoskeletal problems? Learn to walk healthily in Ahinsa shoes.">
      <meta property="og:title" content="What does healthy walking affect?">
      <meta property="og:description" content="Did you know healthy shoes can help with musculoskeletal problems? Learn to walk healthily in Ahinsa shoes.">
    {% endif %}

    {% if request.path == '/blogs/news/tagged/zdravi' %}
      <title>The right footwear supports your health</title>
      <meta name="description" content="Did you know a lot of health problems come from unsuitable shoes? We’ll help you choose shoes your body will love.">
      <meta property="og:title" content="The right footwear supports your health">
      <meta property="og:description" content="Did you know a lot of health problems come from unsuitable shoes? We’ll help you choose shoes your body will love.">
    {% endif %}

    {% if request.path == '/blogs/news/tagged/psychika' %}
      <title>Ahinsa shoes support mental well-being</title>
      <meta name="description" content="Did you know unsuitable shoes can also cause tension in the body? Relax. Put on Ahinsa shoes and simply feel good.">
      <meta property="og:title" content="Ahinsa shoes support mental well-being">
      <meta property="og:description" content="Did you know unsuitable shoes can also cause tension in the body? Relax. Put on Ahinsa shoes and simply feel good.">
    {% endif %}

  {%- else -%}
    <meta property="og:title" content="{{ og_title | escape }}">
  {% endif %}
  <meta property="og:type" content="{{ og_type }}">

  <meta property="og:description" content="{{ og_description | strip_html }}">
  {%- if template_base == 'product' -%}
    <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
    <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  {%- endif -%}
  {%- if page_image -%}
    {% if page.metafields.social_sharing.image != blank %}
      {% assign custom_image = page.metafields.social_sharing.image | img_url: "1200x" %}
      <meta property="og:image" content="https:{{ custom_image }}" />
      <meta property="og:image:secure_url" content="https:{{ custom_image }}">
    {%- else -%}
      <meta property="og:image" content="http:{{ page_image | img_url: 'master' }}">
      <meta property="og:image:secure_url" content="https:{{ page_image | img_url: 'master' }}">
    {% endif %}
    <meta property="og:image:width" content="{{ page_image.width }}">
    <meta property="og:image:height" content="{{ page_image.height }}">
  {%- endif -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ og_title | escape }}">
  <meta name="twitter:description" content="{{ og_description | strip_html }}">






{% comment %} THEME META TAGS {% endcomment %}
{% comment %} {%- liquid
  assign shop_name = shop.name
  assign shop_name_escape = shop_name | escape
  assign shop_domain = shop.domain
  assign og_title = page_title | default: shop_name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop_name
  assign page_image = page_image | default: settings.share_image | default: settings.logo
  
 if t_name == 'product'
    assign og_type = 'product'
  elsif t_name == 'article'
    assign og_type = 'article'
  elsif t_name == 'password'
    assign og_url = request.origin
  endif
 -%}

{%- case t_name -%}
  {%- when 'index' -%}
      {%- if settings.home_keywords != blank -%}<meta name="keywords" content="{{ settings.home_keywords }}"/>{%- else -%}<meta name="keywords" content="{{ shop_name_escape }}, {{ shop_domain }}"/>{%- endif -%}
    {%- when 'product' -%}
      <meta name="keywords" content="{{ product.title | escape }}, {{ shop_name_escape }}, {{ shop_domain }}"/>
    {%- when 'collection' -%}
      <meta name="keywords" content="{{ collection.title | escape }}, {{ shop_name_escape }}, {{ shop_domain }}"/>
    {%- when 'blog' -%}
      <meta name="keywords" content="{{ blog.title | escape }}, {{ shop_name_escape }}, {{ shop_domain }}"/>
    {%- when 'article' -%}
      <meta name="keywords" content="{{ article.title | escape }}, {{ blog.title | escape }}, {{ shop_name_escape }}, {{ shop_domain }}"/>
    {%- when 'search' -%}{%- assign search_name = 'search ' | append:shop_name -%}
      {%- if template == 'search.wish' %}{% assign og_title = 'wishlist_page.meta' | t %}{%- elsif template == 'search.compe' %}{% assign og_title = 'compare_page.meta' | t %}{%- endif -%}
      <meta name="keywords" content="{{ title_term | default: search.terms | default: search_name| escape }}, {{ shop_name_escape }}, {{ shop_domain }}"/>  
    {%- else -%}
      <meta name="keywords" content="{{ page_title | escape }}, {{ shop_name_escape }}, {{ shop_domain }}"/>
{%- endcase -%}
<meta name="author" content="{{ settings.shop_author | default: 'The4' | escape }}">

<meta property="og:site_name" content="{{ shop_name_escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

{%- if t_name == 'product' -%}
  <meta property="og:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}"> {% endcomment %}