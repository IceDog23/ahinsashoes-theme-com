{%- liquid
  assign collection = collections[bk_stts.collection]
  assign block_title = bk_stts.title | default: collection.title
  assign image = bk_stts.image | default: collection.image
  assign image_mob = bk_stts.image_mob
  assign title = bk_stts.collection_title | default: collection.title
  assign collection_link = bk_stts.collection_link | default: collection.url
  assign html = cur_html | split: ','
-%}

{{ html[0] }}
<div
  class="t4s-col-item t4s-collection-item t4s-coll-style-{{ collection_des }} coll-item-{{ stt }} t4s-col-lg-{{ html[1] }} t4s-col-md-{{ html[2] }} t4s-col-{{ html[3] }}"
  id="b_{{ block.id }}"
>
  <div
    class="{% if bk_stts.hero_button != blank %}ahinsa-hero-card {% endif %}t4s-cat-content t4s-source-{{ source }} t4s-eff t4s-eff-{{ b_effect }} t4s-eff-img-{{ img_effect }} t4s-text-center t4s-pr t4s-oh"
    {% unless se_stts.hero_pair %}timeline hdt-reveal="slide-in"{% endunless %}
  >
    <div class="t4s-coll-img t4s-pr" data-cacl-slide>
      {% if collection_des == '11' %}
        <span class="t4s-count">{{ collection.all_products_count | default: 0 }}</span>
      {% endif %}
      <a class="t4s_cat_item_link t4s-img-wrap t4s-d-block" href="{{ collection_link }}" target="{{ open_link }}">
        {%- if se_stts.hero_pair and bk_stts.hero_button != blank -%}
          <div class="ahinsa-pair-media">
            {%- assign hero_priority = 'auto' -%}
            {%- if index0 == 0 -%}{%- assign hero_priority = 'high' -%}{%- endif -%}
            {%- capture hero_tracking -%}{"promotion_id":{{ bk_stts.promotion_id | json }},"promotion_name":{{ bk_stts.promotion_name | json }},"creative_name":{{ bk_stts.creative_name | json }},"location_id":{{ bk_stts.location_id | json }}}{%- endcapture -%}
            <picture>
              {%- if image_mob != blank -%}
                <source media="(max-width: 767px)" srcset="{{ image_mob | image_url: width: 400 }} 400w, {{ image_mob | image_url: width: 800 }} 800w, {{ image_mob | image_url: width: 1200 }} 1200w" sizes="100vw">
              {%- endif -%}
              {{ image | image_url: width: 1600 | image_tag: widths: '400,600,800,1000,1200,1600', sizes: '(min-width: 768px) 50vw, 100vw', loading: 'eager', fetchpriority: hero_priority, class: 'ahinsa-pair-image', alt: title, type: bk_stts.type, value: hero_tracking }}
            </picture>
          </div>
        {%- else -%}
        <div
          class="t4s_ratio t4s_ratio_hasmb t4s-bg-11 collection-list-image"
          style="max-height:{{ max_height }}px;{%- if image != blank -%} background: url({{ image | image_url: width: 1 }});{%- endif -%} --aspect-ratioapt: {{ html[4] }}/{{ html[5] }};--aspect-ratioapttb: {{ html[6] }}/{{ html[7] }};--aspect-ratioaptmb: {{ html[8] }}/{{ html[9] }};"
          data-cacl-slide
        >
          {%- if image != blank -%}
            <img
              {% if image.presentation.focal_point != '50.0% 50.0%' %}
                style="object-position: {{ image.presentation.focal_point }}"
              {% endif %}
              class="lazyloadt4s t4s-lz--fadeIn t4s-obj-eff"
              data-src="{{ image | image_url: width: 1 }}"
              data-widths="[100,200,400,600,700,800,900,1000,1200,1400,1600]"
              data-optimumx="2"
              data-sizes="auto"
              src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
              width="{{ image.width }}"
              height="{{ image.height }}"
              alt="{{ title | default: image.alt | escape }}"
              type="{{ bk_stts.type }}"
              value='{"promotion_id": "{{ bk_stts.promotion_id }}","promotion_name": "{{ bk_stts.promotion_name }}","creative_name": "{{ bk_stts.creative_name }}","location_id": "{{ bk_stts.location_id }}"}'
            >
          {%- else -%}
            {%- assign txt = html[4] | append: 'x' | append: html[5] -%}
            {%- render 'svg_holder', txt: txt, fs: "40px", placeholder_svg_tag: 't4s-placeholder-svg t4s-obj-eff' -%}
          {%- endif -%}
        </div>
        <div
          class="t4s_ratio t4s_ratio_hasmb t4s-bg-11 collection-list-image-mob"
          style="max-height:{{ max_height }}px;{%- if image != blank -%} background: url({{ image | image_url: width: 1 }});{%- endif -%} --aspect-ratioapt: {{ html[4] }}/{{ html[5] }};--aspect-ratioapttb: {{ html[6] }}/{{ html[7] }};--aspect-ratioaptmb: {{ html[8] }}/{{ html[9] }};"
          data-cacl-slide
        >
          {%- if image_mob != blank-%}
            <img
              {% if image_mob.presentation.focal_point != '50.0% 50.0%' %}
                style="object-position: {{ image_mob.presentation.focal_point }}"
              {% endif %}
              class="lazyloadt4s t4s-lz--fadeIn t4s-obj-eff collection-image-mob"
              data-src="{{ image_mob | image_url: width: 1 }}"
              data-widths="[100,200,400,600,700,800,900,1000,1200,1400,1600]"
              data-optimumx="2"
              data-sizes="auto"
              src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
              width="{{ image_mob.width }}"
              height="{{ image_mob.height }}"
              alt="{{ title | default: image_mob.alt | escape }}"
            >
          {%- else -%}
            {%- assign txt = html[4] | append: 'x' | append: html[5] -%}
            {%- render 'svg_holder', txt: txt, fs: "40px", placeholder_svg_tag: 't4s-placeholder-svg t4s-obj-eff' -%}
          {%- endif -%}
        </div>
        {%- endif -%}
        {%- if bk_stts.hero_badge != blank -%}
          <span class="ahinsa-hero-badge">{{ bk_stts.hero_badge | escape }}</span>
        {%- endif -%}
        {%- if bk_stts.hero_button != blank -%}
          <div class="ahinsa-hero-copy">
            <h2>{{ title | escape }}</h2>
            <span class="ahinsa-hero-button">{{ bk_stts.hero_button | escape }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
    {%- if title != blank and bk_stts.hero_button == blank -%}
      <div class="t4s-cate-wrapper">
        <a class="t4s-cat-title" href="{{ collection_link }}" target="{{ open_link }}">
          <span class="t4s-text">{{ title }}</span>
          {% if collection_des == '12' %}
            <span class="t4s-count">{{ collection.all_products_count | default: 0 }}</span>
          {% endif %}
        </a>
        {%- if subtitle != blank -%}
          <a class="t4s-cat-subtitle" href="{{ collection_link }}" target="{{ open_link }}">
            <span class="t4s-count">{{ collection.all_products_count | default: 0 }}</span>
            <span class="t4s-text">{{ subtitle }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
{{ html[10] }}
{% stylesheet %}
.ahinsa-hero-card .t4s_cat_item_link{position:relative}
.ahinsa-hero-copy{position:absolute;z-index:2;left:12px;right:12px;bottom:34px;display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center}
.ahinsa-hero-copy h2{margin:0;color:white;font-size:clamp(24px,3vw,44px);font-weight:700;line-height:1.1;text-shadow:0 2px 12px rgba(0,0,0,.65)}
.ahinsa-hero-button{display:inline-block;background:#111;color:#fff;padding:12px 20px;font-size:16px;font-weight:600;line-height:1.3;text-transform:uppercase}
.ahinsa-hero-card .t4s_cat_item_link:focus-visible{outline:3px solid #fff;outline-offset:-5px}
.ahinsa-hero-card .t4s_cat_item_link:hover .ahinsa-hero-button{background:#333}
@media(max-width:767px){.ahinsa-hero-copy{bottom:18px;left:8px;right:8px;gap:9px}.ahinsa-hero-copy h2{font-size:26px}.ahinsa-hero-button{font-size:12px;padding:10px 12px}}
.ahinsa-hero-pair .ahinsa-hero-card{container-type:inline-size}
.ahinsa-pair-media{position:relative;aspect-ratio:57/50;overflow:hidden}
.ahinsa-pair-media picture{display:block;width:100%;height:100%}
.ahinsa-pair-media .ahinsa-pair-image{display:block;width:100%;height:100%;object-fit:cover}
.ahinsa-hero-pair .coll-item-1 .ahinsa-pair-image{object-position:50% 35%}
.ahinsa-hero-badge{position:absolute;z-index:2;left:6%;top:31%;color:#fff;font-family:var(--font-family-1,inherit);font-size:clamp(42px,16cqi,116px);font-weight:400;line-height:1;letter-spacing:-.055em;white-space:nowrap;pointer-events:none;text-shadow:0 2px 12px rgba(0,0,0,.24)}
@media(max-width:767px){.ahinsa-hero-pair{row-gap:12px}.ahinsa-hero-pair .ahinsa-hero-copy{bottom:24px}.ahinsa-hero-pair .ahinsa-hero-button{font-size:14px;padding:12px 18px}}
{% endstylesheet %}
