    "custom_liquid_KrN8nx": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "<div id='BlackBox' class=\"t4s-image-text-des t4-fs-md-15 t4s-fs-15 t4s-rte\" style=\"text-align: left\">\n    <div style=\"background-color: none; text-align: center; width: 100%; color: black; padding: 10px 10px; margin-top: 20px;\">\n      <h3 style=\"margin-bottom: 15px; color: black\">Lukáš Klimpera’s new physiotherapy clinic in Prague and Brno \n<\/h3>\n    <a href=\"https:\/\/lukasklimpera.cz\/\" target=\"_blank\"><h3 style='color: green; text-decoration: underline;'>Book an appointment &gt;&gt;<\/h3><\/a>\n\n<p>\nAt the clinic, you can look forward to classic physiotherapy as well as a comprehensive footscan examination and 3D printing of individual activation insoles.\n<\/p>\n  \n            <div id=\"f-23-b8218829472e44c561b6577632796e64\"><\/div>\n\n    <\/div>\n  <\/div>",
        "layout": "t4s-container-wrap",
        "cl_bg": "",
        "cl_bg_gradient": "",
        "mg": ",,50px,",
        "pd": "",
        "mg_tb": "",
