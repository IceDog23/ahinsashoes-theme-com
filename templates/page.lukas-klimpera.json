      }
    },
    "image_text_piXN3Y": {
      "type": "image_text",
      "blocks": {
        "bl_image_3qLiKw": {
          "type": "bl_image",
          "settings": {
            "image1": "shopify:\/\/shop_images\/lukas-klimpera-2024-2.jpg",
            "col_dk": "6",
            "col_tb": "6",
            "layout_des": "carousel",
            "post_mobile": "reverse",
            "image_ratio": "ratioadapt",
            "image_size": "contain",
            "image_position": "8",
            "loop": true,
            "au_time": 0,
            "au_hover": true,
            "nav_btn": false,
            "btn_vi": "hover",
            "btn_owl": "default",
            "btn_shape": "none",
