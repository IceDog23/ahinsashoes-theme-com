0,"animation":"none"}}},"block_order":["custom_text_NgarRD","custom_text_NtKRVM"],"settings":{"se_height":"t4s_ratio_cuspx","custom_dk":true,"height_dk":600,"custom_tb":true,"height_tb":400,"custom_mb":true,"height_mb":400,"image":"shopify:\/\/shop_images\/lukas-klimpera-prodejna.png","parallax":false,"image_position":"9","link_img1":"","open_link":"_blank","text_align":"center","text_align_mb":"center","content_width":"container","cv_pos":50,"ch_pos":50,"cv_pos_mb":80,"ch_pos_mb":50,"bg_overlay":"#000000","bg_opacity":20,"bg_content_cl":"#ffffff","bg_content_op":0,"content_pd_tb":15,"content_pd_lr":15,"content_pd_tb_mb":10,"content_pd_lr_mb":10,"border_bl":false,"br_color":"#222222","br_bg":"#ffffff","br_opacity":50,"br_style":"none","br_pd":20,"br_pd_mb":10,"time_animation":1,"animation_delay":40,"layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,30px,","pd_mb":"","use_cus_css":false,"code_cus_css":""}},"custom_liquid_KrN8nx":{"type":"custom-liquid","name":"Custom Liquid","settings":{"custom_liquid":"<div id='BlackBox' class=\"t4s-image-text-des t4-fs-md-15 t4s-fs-15 t4s-rte\" style=\"text-align: left\">\n    <div style=\"background-color: none; text-align: center; width: 100%; color: black; padding: 10px 10px; margin-top: 20px;\">\n      <h3 style=\"margin-bottom: 15px; color: black\">Nová fyzio ordinace Lukáše Klimpery v Praze a Brně \n<\/h3>\n    <a href=\"https:\/\/lukasklimpera.cz\/\" target=\"_blank\"><h3 style='color: green; text-decoration: underline;'>Objednání &gt;&gt;<\/h3><\/a>\n\n<p>\nV ordinaci se můžete těšit jak na klasickou fyzioterapii, tak na komplexní vyšetření na footscanu i 3D tisk individuálních aktivačních stélek.\n<\/p>\n  \n            <div id=\"f-23-b8218829472e44c561b6577632796e64\"><\/div>\n\n    <\/div>\n  <\/div>","layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,30px,","pd_mb":""}},"image_text_piXN3Y":{"type":"image_text","blocks":{"bl_image_3qLiKw":{"type":"bl_image","settings":{"image1":"shopify:\/\/shop_images\/lukas-klimpera-2024-2.jpg","col_dk":"6","col_tb":"6","layout_des":"carousel","post_mobile":"reverse","image_ratio":"ratioadapt","image_size":"contain","image_position":"8","loop":true,"au_time":0,"au_hover":true,"nav_btn":false,"btn_vi":"hover","btn_owl":"default","btn_shape":"none","btn_cl":"dark","btn_size":"small","btn_hidden_mobile":true,"nav_dot":false,"dot_owl":"default","dots_cl":"dark","dots_round":true,"dots_space":10,"dots_hidden_mobile":false}},"bl_text_8fHPNm":{"type":"bl_text","settings":{"quote":false,"smaller_text":false,"col_dk":"6","col_tb":"12","text_size":"40,15","txt_align":"start","sub_heading":"","heading":"","text":"<p>Lukáš Klimpera ušel ke zdravé chůzi dlouhou cestu. Kariéru nastartoval jako programátor, po letech intenzivní práce ale přišlo vyhoření. Proto se rozhodl věnovat oboru, který ho vždy lákal.<\/p><p>Největší inspirací bylo pro Lukáše učení jeho jógového Mistra, <a href=\"https:\/\/www.vishwaguruji.org\/\" target=\"_blank\">Vishwaguru Paramhans Svámího Mahéšvaránandy<\/a>, na jehož podnět vystudoval <strong>fyzioterapii na Univerzitě Karlově<\/strong>, kde se setkal s <a href=\"https:\/\/fyzioterapie.utvs.cvut.cz\/document\/show\/id\/249\/\" target=\"_blank\">Clarou Lewitovou<\/a>. Významná česká fyzioterapeutka Lukáše nadchla svou vizí <strong>zdravých a přirozených bot<\/strong>.<\/p><p>Po škole působil Lukáš na brněnské klinice LOGO pod vedením <strong>primářky Kateřiny Moráňové<\/strong>. A právě tady si ověřil myšlenky Clary Lewitové v praxi. Jeho klienti nepotřebovali jen cvičit. Potřebovali po cvičení obout <strong>boty, které je nesvazují<\/strong>. A protože v Česku zatím nebyla na trhu žádná značka zdravých a etických bot, rozhodl se vytvořit svou vlastní. <\/p><p>Tak vznikly Ahinsa shoes. Ručně vyráběné veganské boty, které <strong>respektují tvar vašeho chodidla<\/strong>. Už během prvních let si získaly své zákazníky v Česku i v zahraničí, dnes je obouvají lidé po celém světě. Ahinsa shoes ale stále jsou a budou <strong>pohodlné a etické boty<\/strong>, které s vámi ujdou miliony kroků.<\/p><p>Pro více infa ze zákulisí můžete Lukáše sledovat na jeho <a href=\"https:\/\/www.instagram.com\/lukasklimpera\/\" target=\"_blank\" title=\"Instagramový profil Lukáše Klimpery\">Instagramu<\/a>.<\/p>","subhd_color":"#202020","hd_color":"#202020","des_color":"#202020","use_shadow":false,"button_label":"Button label","button_link":"","open_link":"_blank","btn_icon":false,"button_style":"default","btn_size":"large","btn_cl":"dark","button_effect":"default"}}},"block_order":["bl_image_3qLiKw","bl_text_8fHPNm"],"settings":{"design_heading":"1","heading_align":"t4s-text-center","top_heading":"","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"space_h_item":"20","space_v_item":"10","space_h_item_mb":"20","space_v_item_mb":"10","layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,30px,","pd_mb":"","use_cus_css":false,"code_cus_css":""}},"feature_columns_q4XXT9":{"type":"feature_columns","blocks":{"text_block_yVrTM7":{"type":"text_block","settings":{"enable_image":false,"title":"","text":"<p>Do ordinace Lukaše Klimpery mě přivedl bolavý halux a bezvýsledná návštěva jiného fyzioterapeuta. Rady, které mi Lukáš dal, mi přinesly v podstatě okamžitou úlevu a ukázaly cestu, jak problém vyřešit. Není to jednoduché, ale jde to, a každý den je to o kousek lepší.<\/p><h5><em>Jana<\/em><\/h5>","button_label":"","button_link":"","open_link":"_blank","btn_icon":false,"button_style":"default","btn_size":"large","btn_cl":"dark","button_effect":"fade"}},"text_block_iR33Ai":{"type":"text_block","settings":{"enable_image":false,"title":"","text":"<p>Byla jsem u p.Klimpery se svými dlouholetými problémy s chodidly. Narozdíl od jiných podologů používá moderní přístroj na měření nohou - nejen ve stoji, ale i při chůzi. Díval se na můj problém jinak než ostatní a měl velkou snahu mé potíže odstranit. Nyní doma cvičím a těším se na další návštěvu.<\/p><h5><em>Karolína<\/em><\/h5>","button_label":"","button_link":"","open_link":"_blank","btn_icon":false,"button_style":"default","btn_size":"large","btn_cl":"dark","button_effect":"fade"}},"text_block_7KDfxC":{"type":"text_block","settings":{"enable_image":false,"title":"","text":"<p>Návštěva ordinace pana Lukáše pro mne byla především vzděláváním o mém těle, o nalezení příčiny mého tělového strádání, o umožnění tělu rozvíjet svoje současné pohybové možnosti tak, aby postupně dosahovalo optimální funkce a tím plynulého vyzdravování. To vše při empatickém přístupu fyzioterapeuta, který se s vámi těší z každého vašeho vylepšení  a stále kreativně vymýšlí nové možnosti. Mockrát děkuji!<\/p><h5><em>Radana<\/em><\/h5>","button_label":"","button_link":"","open_link":"_blank","btn_icon":false,"button_style":"default","btn_size":"large","btn_cl":"dark","button_effect":"fade"}},"text_block_GMM7dQ":{"type":"text_block","settings":{"enable_image":false,"title":"","text":"<p>Se synem (11) jsme šli na fyzioterapii k panu Klimperovi kvůli plochonoží a byli jsme moc spokojeni. Syna pořádně prohlédnul, vše nám krásně vysvětlil, ukázal a poradil, co by bylo potřeba změnit a jakým způsobem cvičit doma. Snažíme se poctivě cvičit a za pár týdnu se chystáme na kontrolu, jestli pracujeme správně. Lukáše Klimperu mohu vřele doporučit.<\/p><h5><em>Kateřina<\/em><\/h5>","button_label":"","button_link":"","open_link":"_blank","btn_icon":false,"button_style":"default","btn_size":"large","btn_cl":"dark","button_effect":"fade"}},"text_block_VpMzLY":{"type":"text_block","settings":{"enable_image":false,"title":"","text":"<p>Velmi oceňuji profesionální a zároveň individuální přístup. Komunikace byla po celou dobu bezproblémová a srozumitelná. Jako velkou přidanou hodnotu vnímám snahu o opravdu komplexní pohled na problém a upřímnou snahu jej řešit a dlouhodobě pomoci, ne jen krátkodobě ulevit. Rád doporučuji dál.<\/p><h5><em>Pavel<\/em><\/h5>","button_label":"","button_link":"","open_link":"_blank","btn_icon":false,"button_style":"default","btn_size":"large","btn_cl":"dark","button_effect":"fade"}}},"block_order":["text_block_yVrTM7","text_block_iR33Ai","text_block_7KDfxC","text_block_GMM7dQ","text_block_VpMzLY"],"name":"Text columns with image","settings":{"design_heading":"1","heading_align":"t4s-text-center","top_heading":"Co o fyzioterapii říkají mí klienti:","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"text_align":"center","pos_text":"default","fs_title":22,"fs_text":14,"fs_title_mb":22,"fs_text_mb":12,"image_ratio":"ratio16_9","image_size":"cover","image_position":"8","img_effect":"none","b_effect":"none","layout_des":"2","space_h_item":"30","space_v_item":"30","space_h_item_mb":"10","space_v_item_mb":"10","col_dk":"3","col_tb":"2","col_mb":"1","loop":true,"au_time":0,"au_hover":true,"nav_btn":false,"btn_vi":"hover","btn_owl":"default","btn_shape":"none","btn_cl":"dark","btn_size":"small","btn_hidden_mobile":true,"nav_dot":true,"dot_owl":"default","dots_cl":"dark","dots_round":true,"dots_space":10,"dots_hidden_mobile":false,"layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,30px,","pd_mb":"","use_cus_css":false,"code_cus_css":""}},"blog_post_manual_ppBXA3":{"type":"blog-post-manual","blocks":{"article_rD9kTU":{"type":"article","settings":{"article":"news\/rozhovor-o-barefoot-lukas-klimpera"}},"article_T4TjPT":{"type":"article","settings":{"article":"news\/rozhovor-zacatky-vyroby-barefoot-lukas-klimpera"}}},"block_order":["article_rD9kTU","article_T4TjPT"],"settings":{"design_heading":"1","heading_align":"t4s-text-center","top_heading":"Kde se můžete o Lukáši Klimperovi dozvědět víc","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"post_des":"1","show_cate":false,"show_tags":false,"show_cnt":false,"show_au":false,"show_dt":false,"s