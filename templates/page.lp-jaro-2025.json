: 5px;\n        }\n\n        .button:hover {\n            background-color: #333; \/* Slightly lighter black on hover *\/\n        }\n    <\/style>\n<\/head>\n<body>\n    <!-- Centered button -->\n    <a href=\"https:\/\/ahinsashoes.cz\/collections\/vyprodej\" class=\"button\">Pojďte si vybrat<\/a>\n<\/body>\n<\/html>","layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,30px,","pd_mb":""}}},"order":["heading","hero_image_xwdyXH","main","sidebar-page","top_heading_HAJg8Q","image_text_HmWn8H","image_text_YG8MYD","image_text_z8qNTp","image_text_eUki4E","image_text_4YXLNx","image_text_TmKTKx","image_gallery_packery_RFez7J","image_text_UVkxqX","custom_liquid_L3amWe"]}