s\/aktivni-stelky","title":"","desc":"➡️ Vhodné pro podporu aktivnější chůze a stability, lepšího vnímání prstů a vědomějšího odrazu od prstů.","btn_txt":"Nakoupit","btn_url":""}}},"block_order":["product_dyHpxE","product_GDUL9c","product_4wUDBE","product_TRRBAA","product_ydLyke"],"name":"Featured collection 2","settings":{"design_heading":"1","heading_align":"t4s-text-center","top_heading":"Vyberte si ty své:","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"image_ratio":"ratio3_2","image_size":"cover","image_position":"8","show_des_pr":true,"show_btn":true,"btn_icon":true,"button_style":"default","btns_size":"medium","btns_cl":"dark","button_effect":"default","content_align":"center","limit":5,"col_dk":"5","col_tb":"3","col_mb":"2","space_h_item":"30","space_v_item":"30","space_h_item_mb":"10","space_v_item_mb":"10","layout_des":"2","loop":true,"au_time":0,"au_hover":true,"nav_btn":false,"btn_vi":"always","btn_owl":"outline","btn_shape":"none","btn_cl":"dark","btn_size":"small","btn_hidden_mobile":false,"nav_dot":true,"dot_owl":"outline","dots_cl":"dark","dots_round":true,"dots_space":10,"dots_hidden_mobile":false,"layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":"50px,,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,30px,","pd_mb":"","use_cus_css":true,"code_cus_css":".t4s-product-price {\n    font-size: 20px !important;\n}"}},"image_text_hnKPGJ":{"type":"image_text","blocks":{"bl_text_BhUEMJ":{"type":"bl_text","settings":{"quote":false,"smaller_text":false,"col_dk":"6","col_tb":"6","text_size":"40,15","txt_align":"start","sub_heading":"Clara Lewitová – fyzioterapeutka","heading":"\"Klíčem je vnímání.\"","text":"<p>Tělo se mění nejlépe tehdy, když samo začne lépe vnímat, co dělá.<\/p><p>To, jak <strong>stojíme<\/strong>, <strong>sedíme<\/strong>, <strong>chodíme<\/strong> nebo se <strong>pohybujeme<\/strong>, není jen otázka svalů. Velkou roli hrají <strong>pohybové programy v našem mozku<\/strong> – naučené způsoby držení těla, opory a pohybu.<\/p><p>Jenže pokud chodidla nevnímáme, mozek z nich dostává málo informací. A tělo pak často hledá stabilitu jinde: v napětí, přetížení, zbytečné kompenzaci nebo pasivním „zavěšení“ do kloubů.<\/p><p><strong>Aktivní stélky pomáhají chodidlu<\/strong> <strong>znovu posílat jasnější informace<\/strong>. Neopravují tělo za vás. Nabízejí mu podnět, díky kterému se může samo <strong>aktivněji zapojit<\/strong>.<\/p>","subhd_color":"#000000","hd_color":"#000000","des_color":"#000000","use_shadow":false,"button_label":"Button label","button_link":"","open_link":"_blank","btn_icon":false,"button_style":"default","btn_size":"large","btn_cl":"dark","button_effect":"default"}},"bl_image_UALyG9":{"type":"bl_image","settings":{"image1":"shopify:\/\/shop_images\/Kopie_souboru_IMG_8786.jpg","col_dk":"6","col_tb":"6","layout_des":"carousel","post_mobile":"default","image_ratio":"ratioadapt","image_size":"cover","image_position":"8","loop":true,"au_time":0,"au_hover":true,"nav_btn":false,"btn_vi":"hover","btn_owl":"default","btn_shape":"none","btn_cl":"dark","btn_size":"small","btn_hidden_mobile":true,"nav_dot":false,"dot_owl":"default","dots_cl":"dark","dots_round":true,"dots_space":10,"dots_hidden_mobile":false}}},"block_order":["bl_text_BhUEMJ","bl_image_UALyG9"],"name":"Image with text","settings":{"design_heading":"1","heading_align":"t4s-text-start","top_heading":"","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"space_h_item":"20","space_v_item":"10","space_h_item_mb":"20","space_v_item_mb":"10","layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,30px,","pd_mb":"","use_cus_css":false,"code_cus_css":""}},"testimonials_DxPaBi":{"type":"testimonials","disabled":true,"settings":{"design_heading":"2","heading_align":"t4s-text-center","top_heading":"Pozor: Platí jen do vyprodání zásob. A jak vás známe, bude to rychlé.","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"ter_des":"1","cl_name":"#222222","cl_content":"#202020","cl_bd":"","cl_bg_item":"","bdr":13,"content_align":"text-center","col_dk":"2","col_tb":"2","col_mb":"1","space_h_item":"30","space_v_item":"30","space_h_item_mb":"10","space_v_item_mb":"10","layout_des":"1","loop":true,"au_time":0,"au_hover":true,"nav_btn":false,"btn_vi":"hover","btn_owl":"default","btn_shape":"none","btn_cl":"dark","btn_size":"small","btn_hidden_mobile":true,"nav_dot":false,"dot_owl":"default","dots_cl":"dark","dots_round":true,"dots_space":10,"dots_hidden_mobile":false,"layout":"t4s-container-wrap","cl_bg":"rgba(0,0,0,0)","cl_bg_gradient":"","mg":",,,","pd":"40px,,40px","mg_tb":"","pd_tb":"","mg_mb":",,,","pd_mb":"40px,,40px","use_cus_css":false,"code_cus_css":""}},"feature_columns_azRxnE":{"type":"feature_columns","blocks":{"text_block_QM4wca":{"type":"text_block","settings":{"enable_image":false,"title":"","text":"<p><em>Konečně cítím prsty na zemi a můžu je při chůzi opřít o stélky. \"Nutí\" mě chodit pomaleji, víc si uvědomovat napřímení těla.<\/em><\/p><h4><strong>Karolina<\/strong><\/h4>","button_label":"","button_link":"","open_link":"_blank","btn_icon":false,"button_style":"default","btn_size":"large","btn_cl":"dark","button_effect":"fade"}},"text_block_WfDcYz":{"type":"text_block","settings":{"enable_image":false,"title":"","text":"<p><em>Po pár dnech nošení stélek zažívám příjemné uvolnění chodidel. Překvapilo mě, jak člověk zpozorní a více vnímá zapojení chodidla.<\/em><\/p><h4><strong>Vendula<\/strong><\/h4>","button_label":"","button_link":"","open_link":"_blank","btn_icon":false,"button_style":"default","btn_size":"large","btn_cl":"dark","button_effect":"fade"}},"text_block_zQVhrk":{"type":"text_block","settings":{"enable_image":false,"title":"","text":"<p><em>Aktivní stélky jsou taková každodenní masáž chodidel. Při jejich nošení mnohem více vnímám kontakt chodidel se zemí.<\/em><\/p><h4><strong>Kristýna<\/strong><br\/><\/h4>","button_label":"","button_link":"","open_link":"_blank","btn_icon":false,"button_style":"default","btn_size":"large","btn_cl":"dark","button_effect":"fade"}}},"block_order":["text_block_QM4wca","text_block_WfDcYz","text_block_zQVhrk"],"name":"Text columns with image","settings":{"design_heading":"1","heading_align":"t4s-text-center","top_heading":"➡️ Co na aktivní stélky říkají naši zákazníci?","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"text_align":"center","pos_text":"default","fs_title":22,"fs_text":14,"fs_title_mb":22,"fs_text_mb":12,"image_ratio":"ratio16_9","image_size":"cover","image_position":"8","img_effect":"none","b_effect":"none","layout_des":"1","space_h_item":"30","space_v_item":"30","space_h_item_mb":"10","space_v_item_mb":"10","col_dk":"3","col_tb":"2","col_mb":"1","loop":true,"au_time":0,"au_hover":true,"nav_btn":false,"btn_vi":"hover","btn_owl":"default","btn_shape":"none","btn_cl":"dark","btn_size":"small","btn_hidden_mobile":true,"nav_dot":false,"dot_owl":"default","dots_cl":"dark","dots_round":true,"dots_space":10,"dots_hidden_mobile":false,"layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":"70px,,70px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,30px,","pd_mb":"","use_cus_css":false,"code_cus_css":""}},"image_text_B7ewcW":{"type":"image_text","blocks":{"bl_image_3dLT3y":{"type":"bl_image","settings":{"image1":"shopify:\/\/shop_images\/IMG_8935_561c1024-bf8e-4765-960e-c8c970877fd1.jpg","col_dk":"6","col_tb":"6","layout_des":"carousel","post_mobile":"default","image_ratio":"ratioadapt","image_size":"cover","image_position":"8","loop":true,"au_time":0,"au_hover":true,"nav_btn":false,"btn_vi":"hover","btn_owl":"default","btn_shape":"none","btn_cl":"dark","btn_size":"small","btn_hidden_mobile":true,"nav_dot":false,"dot_owl":"default","dots_cl":"dark","dots_round":true,"dots_space":10,"dots_hidden_mobile":false}},"bl_text_k7XziE":{"type":"bl_text","settings":{"quote":false,"smaller_text":false,"col_dk":"6","col_tb":"6","text_size":"40,15","txt_align":"start","sub_heading":"","heading":"Chcete vložky do bot na míru?","text":"<p>Naše Aktivní stélky jsou skvělým začátkem pro každého, kdo chce svým chodidlům <strong>dopřát jemnou stimulaci<\/strong> a <strong>podpořit jejich přirozenou práci<\/strong>. Pokud ale hledáte řešení přesně podle svých potřeb, nabízíme také<strong> individuální aktivní stélky<\/strong> <strong>vytvořené ve spolupráci s fyzioterapeutem<\/strong>.<\/p><p>Nejprve proběhne odborné vyšetření a <strong>analýza chůze<\/strong> pomocí nástroje <strong>Footscan<\/strong>. Na základě výsledků vznikne stélka vyrobená <strong>3D tiskem<\/strong>, která zohledňuje způsob, jakým vaše chodidla při chůzi skutečně pracují. Podle doporučení fyzioterapeuta může být doplněna o individuálně umístěné stimulační prvky.<\/p><p>Velkou výhodou individuálního vyšetření je, že se nezaměřuje pouze na chodidla. Fyzioterapeut <strong>posuzuje celé držení těla<\/strong>, způsob pohybu i vzájemné souvislosti jednotlivých částí pohybového aparátu. <strong>Díky tomu vzniká řešení, které zohledňuje nejen vaše nohy, ale fungování celého těla<\/strong>.<\/p>","subhd_color":"#000000","hd_color":"#000000","des_color":"#000000","use_shadow":false,"button_label":"Chci stélky na míru","button_link":"http:\/\/www.lukasklimpera.cz\/","open_link":"_blank","btn_icon":false,"button_style":"outline","btn_size":"extra-medium","btn_cl":"dark","button_effect":"default"}}},"block_order":["bl_image_3dLT3y","bl_text_k7XziE"],"name":"Image with text","settings":{"design_heading":"1","heading_align":"t4s-text-start","top_heading":"","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"space_h_item":"20","space_v_item":"10","space_h_item_mb":"20","space_v_item_mb":"10","layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,50px,","pd_mb":"","use_cus_css":false,"code_cus_css":""}},"accordion_rimCJQ":{"type":"accordion","blocks":{"accor_item_xaremc":{"type":"accor_item","settings":{"icon":"none","title":"Pro koho aktivní stélky nejsou? Kdy si dát pozor?","content":"<p>Ve většině případů si aktivní stélky můžete užívat bez obav. Pokud ale řešíte zdravotní potíže, <strong>doporučujeme se před jejich používáním poradit s fyzioterapeutem nebo lékařem<\/strong>. Obzvlášť v těchto případech:<\/p><ul><li>máte výrazné nebo dlouhodobé bolesti chodidel<\/li><li>jste čerstvě po úrazu nebo po operaci<\/li><li>zažíváte neurologické obtíže nebo ztrátu citlivosti chodidel<\/li><li>jiné závažnější zdravotní potíže<\/li><\/ul>"}},"accor_item_PVK77E":{"type":"accor_item","settings":{"icon":"none","title":"Můžu akupresurní vložky do bot používat i při cvičení a běhání?","content":"<p>Ano. Aktivní stélky můžete používat při silovém tréninku, běhání i dalších pohybových aktivitách. Jemná stimulace chodidel pomáhá lépe vnímat oporu a zapojení celého těla při cvičení. Při běhu může podpořit aktivnější odraz i lepší vnímání kontaktu se zemí. Doporučujeme ale začínat postupně a dopřát chodidlům čas na adaptaci.<\/p>"}},"accor_item_Q6mnqX":{"type":"accor_item","settings":{"icon":"none","title":"Do jaké obuvi jsou aktivní stélky vhodné?","content":"<p>Nejlépe fungují v barefoot a anatomicky tvarované obuvi, kde mají chodidla dostatek prostoru pro přirozený pohyb. Používat je ale můžete i v běžné obuvi, pokud není příliš úzká nebo těsná.<\/p>"}},"accor_item_bnxjgW":{"type":"accor_item","settings":{"icon":"none","title":"Jsou aktivní stélky zdravotnický prostředek?","content":"<p>Ne. Aktivní stélky nejsou zdravotnický prostředek a nejsou náhradou odborné diagnostiky, fyzioterapie ani lékařské péče. Jsou navržené tak, aby podpořily vnímání chodidel a jejich aktivnější zapojení při chůzi i stání.<\/p><p><strong>Před použitím doporučujeme konzultaci s lékařem nebo fyzioterapeutem zejména v případě:<\/strong><\/p><ul><li>cukrovky, především při snížené citlivosti chodidel nebo neuropatii,<\/li><li>poruch čití,<\/li><li>otevřených ran, otlaků nebo kožních potíží,<\/li><li>akutního úrazu nebo bolesti,<\/li><li>výrazných neurologických potíží,<\/li><li>závažných poruch rovnováhy nebo koordinace,<\/li><li>nejistoty, zda jsou stélky pro vás vhodné.<\/li><\/ul><p>Při bolesti, zhoršení obtíží nebo nepříjemné reakci používání přerušte a poraďte se s odborníkem.<\/p>"}},"accor_item_8TwcCn":{"type":"accor_item","settings":{"icon":"none","title":"Pomohou mi od bolesti nohou, kolen nebo zad?","content":"<p>To bohužel nemůžeme slíbit. Chodidla ale ovlivňují pohyb celého těla, a proto může jejich lepší zapojení přispět k příjemnějšímu pohybu. Pokud vás trápí bolesti nebo jiné zdravotní obtíže, doporučujeme poradit se s fyzioterapeutem nebo lékařem.<\/p>"}},"accor_item_Akt7Rx":{"type":"accor_item","settings":{"icon":"none","title":"Kdy poznám první rozdíl?","content":"<p>Každý to má trochu jinak. Někdo změnu vnímá už po prvním obutí, jinému chvíli trvá, než si chodidla na nový podnět zvyknou. Proto doporučujeme začít pozvolna a dobu nošení postupně prodlužovat.<\/p>"}},"accor_item_DPwrqE":{"type":"accor_item","settings":{"icon":"none","title":"Můžu si stélky zastřihnout podle tvaru boty?","content":"<p>Ano. Stélky si můžete jednoduše upravit podle tvaru své obuvi. Doporučujeme zastřihávat je postupně po menších částech. Po zastřižení už je nelze vrátit jako nepoužité zboží, záruka na ně ale samozřejmě zůstává.<\/p>"}},"accor_item_Hw3UhE":{"type":"accor_item","settings":{"icon":"none","title":"Můžou se stélky nosit s ponožkama?","content":"<p>Stélky jsou primárně navrženy pro použití na bosou nohu. <strong>Intenzitu ale můžete snadno regulovat ponožkou <\/strong>– tenká ponožka stimulaci jemně ztlumí, silnější ponožka ji ztlumí více.<\/p><p>Vnímání má být jasné, ale příjemné. Ne bolestivé.<\/p>"}},"accor_item_6bgRQT":{"type":"accor_item","settings":{"icon":"none","title":"Jak se správně starat o vložky do bot?","content":"<p>Stačí je pravidelně větrat a podle potřeby otřít vlhkým hadříkem. Nedoporučujeme je prát v pračce ani sušit na přímém zdroji tepla.<\/p>"}},"accor_item_GMUnwy":{"type":"accor_item","settings":{"icon":"none","title":"Mohou aktivní stélky používat i děti?","content":"<p>V tuto chvíli jsou aktivní stélky navržené pro dospělé ve velikostech 37–46. Dětskou variantu zatím nepřipravujeme.<\/p>"}},"accor_item_T6jprW":{"type":"accor_item","settings":{"icon":"none","title":"Jak je to s vrácením nebo reklamací?","content":"<p>Na aktivní stélky se vztahuje standardní zákonná záruka. Nepoužité a nepoškozené stélky můžete vrátit do 14 dnů. Pozor, pokud si je zastřihnete nebo jakkoliv jinak upravíte, už je není možné vrátit jako nepoužité zboží.<\/p>"}}},"block_order":["accor_item_xaremc","accor_item_PVK77E","accor_item_Q6mnqX","accor_item_bnxjgW","accor_item_8TwcCn","accor_item_Akt7Rx","accor_item_DPwrqE","accor_item_Hw3UhE","accor_item_6bgRQT","accor_item_GMUnwy","accor_item_T6jprW"],"name":"Accordion","settings":{"design_heading":"1","heading_align":"t4s-text-center","top_heading":"Mohlo by Vás zajímat:","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"accor_des":"1","title_cl":"#222","bg_title_cl":"#f6f6f8","title_active_cl":"#000","bg_title_active_cl":"#f6f6f8","content_cl":"#878787","bg_content_cl":"#fff","content_align":"t4s-text-start","auto_active":true,"layout":"t4s-container-wrap","custom_width":1000,"cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":"50px,,50px,","pd_mb":"","use_cus_css":false,"code_cus_css":""}},"banner_D8GaeB":{"type":"banner","blocks":{"b_item_6LgnLz":{"type":"b_item","settings":{"custom_dk":true,"height_dk":600,"custom_tb":true,"height_tb":400,"custom_mb":true,"height_mb":300,"image":"shopify:\/\/shop_images\/infografika_active_insoles.png","b_link":"","open_link":"_self","img_effect":"none","b_effect":"none","col_dk":"12","col_tb":"9","col_mb":"12","content_align":"center","content_align_mobile":"center","content_width":"fullwidth","cv_pos":50,"ch_pos":50,"cv_pos_mb":50,"ch_pos_mb":50,"bg_overlay":"#000","bg_opacity":0,"bg_content_bl":fa