        "bl_text_GhjXQh": {
          "type": "bl_text",
          "settings": {
            "col_dk": "6",
            "col_tb": "6",
            "text_size": "40,15",
            "txt_align": "start",
            "sub_heading": "",
            "heading": "How to use active insoles?",
            "text": "<p>Give your feet time to get used to the new feeling. With a gradual start, you’ll enjoy using active insoles fully.<\/p><ul><li>Start slowly — try a short walk first<\/li><li>Gradually extend wearing time based on how you feel<\/li><li>If it feels comfortable, you can use them every day<\/li><li>If needed, trim the insoles to the shape of your shoes<\/li><\/ul><p>The insoles are designed to be worn on a bare foot. You can easily adjust the intensity with a sock — a thin sock softens it slightly, a thicker sock softens it more.<\/p>",
            "subhd_color": "#222222",
            "hd_color": "#222222",
            "des_color": "#878787",
            "use_shadow": false,
            "button_label": "Button label",
            "button_link": "",
            "open_link": "_blank",
            "btn_icon": false,
            "button_style": "default",
            "btn_size": "large",
            "btn_cl": "dark",
            "button_effect": "default"
          }
        }
      },
