        "bl_text_QM7mQC": {
          "type": "bl_text",
          "settings": {
            "quote": false,
            "smaller_text": false,
            "col_dk": "6",
            "col_tb": "6",
            "text_size": "40,15",
            "txt_align": "start",
            "sub_heading": "",
            "heading": "",
            "text": "<h3>Ahinsa Malai<\/h3><h4>Beauty from coconut waste<\/h4><p><\/p><p><strong>Farmers in India<\/strong> produce mountains of coconut waste every day. A Slovak designer has found the perfect use for it: She feeds it to the bacteria that produce cellulose. From that, she then makes a <strong>gorgeous and durable material<\/strong>.<\/p><p>It's so incredible that we decided to make an exception.<br\/><\/p><p>• Degradable fabric from waste from Indian farmers.<\/p><p>• A sole made from a recycled tire.<\/p><p>• It will attract looks and compliments. :)<\/p><p><a href=\"\/products\/damske-sandaly-z-kokosu\" title=\"Women's Malai coconut sandals\"><strong>Ahinsa Malai models<\/strong><\/a><\/p>",
            "subhd_color": "#222222",
            "hd_color": "#222222",
            "des_color": "#202020",
            "use_shadow": false,
            "button_label": "",
            "button_link": "",
            "open_link": "_blank",
            "btn_icon": false,
            "button_style": "link",
            "btn_size": "extra-large",
            "btn_cl": "primary",
            "button_effect": "default"
          }
        }
      },
