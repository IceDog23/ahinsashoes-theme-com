    "image_text_8fieMe": {
      "type": "image_text",
      "blocks": {
        "bl_text_pbiyyh": {
          "type": "bl_text",
          "settings": {
            "quote": false,
            "smaller_text": false,
            "col_dk": "6",
            "col_tb": "6",
            "text_size": "40,15",
            "txt_align": "start",
            "sub_heading": "",
            "heading": "",
            "text": "<h3>Ahinsa Mabel<\/h3><h4>Leather made from apples helps the planet<\/h4><p><\/p><p>There are a lot of ways to make things easier for the planet. One of them smells like apple pie.<br\/><br\/>Mabel is a material that <strong>is made of 25% apple waste<\/strong>. It looks like leather, it lasts for years, and it helps create more sustainable Ahinsa shoes.<br\/><br\/>It's nothing new. Mabel material has been produced <strong>in Tuscany since 2010<\/strong> and has proven to be useful to shoemakers and furniture manufacturers.<br\/><\/p><p>• Sustainable material<\/p><p>• 24% made from apple waste<\/p><p>• Firm and durable<\/p><p><a href=\"\/pages\/ahinsa-jeans\" title=\"Ahinsa Jeans\"><strong>How it works<\/strong><\/a><\/p>",
            "subhd_color": "#222222",
            "hd_color": "#222222",
