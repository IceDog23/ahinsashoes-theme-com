,"subhd_color":"#202020","hd_color":"#202020","des_color":"#202020","use_shadow":false,"button_label":"Button label","button_link":"","open_link":"_blank","btn_icon":false,"button_style":"default","btn_size":"large","btn_cl":"dark","button_effect":"default"}}},"block_order":["bl_liquid_V87iXp","bl_text_jwGehB"],"settings":{"design_heading":"1","heading_align":"t4s-text-center","top_heading":"","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"space_h_item":"20","space_v_item":"10","space_h_item_mb":"20","space_v_item_mb":"10","layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,30px,","pd_mb":"","use_cus_css":false,"code_cus_css":""}},"our_mission_qYpCAP":{"type":"our_mission","blocks":{"om_item_AT8rXH":{"type":"om_item","settings":{"heading":"Nadměrek","content":"Před prsty musí vždy zůstat volný prostor, aby se noha mohla přirozeně pohybovat. Proto se nelekejte, že jsou vám boty „větší“.<br>\n<b>Když se postavíte na špičky, měl by vám před prsty zůstávat volný prostor asi na prst.<\/b>","text_align":"start","col_tb":"6","col_mb":"6"}},"om_item_GanpAi":{"type":"om_item","settings":{"heading":"Šířka nohy a výška nártu","content":"U každého modelu Ahinsa shoes najdete také informace o šířce v nejširším bodě a o obvodu nártu.<br>\n<b>Pokud víte, že vám bývají boty úzké, zaměřte se na tyto rozměry.<\/b>","text_align":"start","col_tb":"6","col_mb":"6"}}},"block_order":["om_item_AT8rXH","om_item_GanpAi"],"settings":{"design_heading":"1","heading_align":"t4s-text-center","top_heading":"Při zkoušení a výběru velikosti si dejte pozor na...","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"space_h_item":"30","space_v_item":"30","space_h_item_mb":"10","space_v_item_mb":"10","layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,30px,","pd_mb":"","use_cus_css":false,"code_cus_css":""}},"image_text_zePBDe":{"type":"image_text","blocks":{"bl_text_JEAGRz":{"type":"bl_text","settings":{"quote":false,"smaller_text":false,"col_dk":"6","col_tb":"6","text_size":"40,15","txt_align":"start","sub_heading":"","heading":"3D měření nohou","text":"<p>Do fyzio ordinace Lukáše Klimpery jsme pořídili přístroj <strong>Footscan<\/strong>, se kterým fyzioterapeut snadno analyzuje vaši chůzi.<\/p><p><\/p><p>I díky Footscanu vám odpovíme na důležité otázky:<\/p><ul><li>Chodím zdravě?<\/li><li>Jaké boty bych měl(a) nosit?<\/li><li>Proč mě po procházce bolí nohy nebo záda?<\/li><\/ul>","subhd_color":"#202020","hd_color":"#202020","des_color":"#202020","use_shadow":false,"button_label":"Rezervujte si termín včas","button_link":"shopify:\/\/pages\/footscan","open_link":"_self","btn_icon":false,"button_style":"default","btn_size":"medium","btn_cl":"dark","button_effect":"default"}},"bl_image_GUTMpi":{"type":"bl_image","settings":{"image1":"shopify:\/\/shop_images\/Kopie_souboru_IMG_8669.jpg","col_dk":"6","col_tb":"6","layout_des":"carousel","post_mobile":"default","image_ratio":"ratioadapt","image_size":"cover","image_position":"8","loop":true,"au_time":0,"au_hover":true,"nav_btn":false,"btn_vi":"hover","btn_owl":"default","btn_shape":"none","btn_cl":"dark","btn_size":"small","btn_hidden_mobile":true,"nav_dot":false,"dot_owl":"default","dots_cl":"dark","dots_round":true,"dots_space":10,"dots_hidden_mobile":false}}},"block_order":["bl_text_JEAGRz","bl_image_GUTMpi"],"settings":{"design_heading":"1","heading_align":"t4s-text-center","top_heading":"","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"space_h_item":"20","space_v_item":"10","space_h_item_mb":"20","space_v_item_mb":"10","layout":"t4s-container-wrap","cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,30px,","pd_mb":"","use_cus_css":false,"code_cus_css":""}},"accordion_cwnV8p":{"type":"accordion","blocks":{"accor_item_CdJpWE":{"type":"accor_item","settings":{"icon":"none","title":"Mám širokou nohu. Jaké Ahinsa shoes mi sednou?","content":"<p>Speciálně pro široké nohy jsme navrhli <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=xwide\">řadu xWide<\/a>. Všechny boty s tímto označením jsou <strong>dostatečně široké<\/strong>, aby v nich mohly vaše nohy přirozeně fungovat. Najdete u nás extra široké <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=xwide+sand%C3%A1ly\">sandály<\/a>, <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=xwide+polobotky\">polobotky<\/a>, <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=xwide+tenisky\">tenisky<\/a> i <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=xwide+kotn%C3%ADkov%C3%A9\">kotníčkové boty<\/a>. <\/p>"}},"accor_item_jkrU7J":{"type":"accor_item","settings":{"icon":"none","title":"Mám úzkou nohu. Jaké Ahinsa shoes mi sednou?","content":"<p>Jestli sháníte balerínky na úzkou nohu, máme pro vás skvělou zprávu: právě balerínky jsme pro vás navrhli a vyrobili v extra úzké variantě. Najdete u nás variantu <a href=\"https:\/\/ahinsashoes.cz\/products\/ahinsa-bare-balerinka-cerna\">s páskem přes nárt<\/a> nebo <a href=\"https:\/\/ahinsashoes.cz\/products\/extra-uzke-barefoot-balerinky-ananda-cerne\">bez pásku<\/a>.<\/p><p>Kromě balerínek vám sednou <strong>všechny naše boty se šněrováním nebo nastavitelným páskem<\/strong>.<\/p><ul><li><strong>Na léto <\/strong>doporučujeme <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=%C5%A1%C3%A1tek*\">vázací sandály s šátkem<\/a>, <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=ballerina*\">střevíčky Ballerina<\/a> nebo sandály <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=suna*\">Suna<\/a> na gumičku.<\/li><li><strong>Na podzim a zimu zimní <\/strong>tenisky <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=tara+winter\">Tara Winter<\/a>, <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=chelsea*\">Chelsea boots<\/a>, šněrovací kozačky <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=jaya*\">Jaya<\/a> a kotníkové boty <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=sundara+winter\">Sundara Winter<\/a>.<\/li><li><strong>Na celý rok<\/strong> tenisky <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=vida\">Vida<\/a>.<\/li><\/ul>"}},"accor_item_UdexmU":{"type":"accor_item","settings":{"icon":"none","title":"Mám vysoký nárt. Jaké Ahinsa shoes mi sednou?","content":"<p>Ahinsa shoes jsou velmi prostorné. Nejlíp vám ale padnou<strong> šněrovací modely<\/strong>. Zákazníci s vysokým nártem si nejvíc chválí naše <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=chitra*\">tenisky Chitra<\/a>, protože jsou šněrovací, a navíc z velmi poddajné síťoviny.<\/p><p>Dál doporučujeme:<\/p><ul><li><strong>Na celý rok<\/strong><a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=flow*\"> tenisky Flow<\/a> ze síťoviny a <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=pura*\">klasické tenisky Pura<\/a> z veganské kůže. Jestli máte rádi suchý zip, pak i <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=quick\">kotníkové tenisky Quick<\/a>.<\/li><li><strong>Na léto <\/strong>doporučujeme <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=%C5%A1%C3%A1tek*\">vázací sandály s šátkem<\/a>, elegantní <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=hava\">nastavitelné sandály Hava<\/a> a trekové <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=adventure\">Adventure<\/a> nebo <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=verso*\">Verso<\/a>.<\/li><li><strong>Na podzim a zimu<\/strong> vám padnou šněrovací kozačky <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=jaya*\">Jaya<\/a> a kotníkové boty <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=sundara+winter\">Sundara Winter<\/a><\/li><\/ul>"}},"accor_item_c6ADLP":{"type":"accor_item","settings":{"icon":"none","title":"Mám široké lýtko. Jaké Ahinsa shoes mi sednou?","content":"<p>Jestli hledáte <strong>kozačky<\/strong>, doporučujeme<strong> šněrovací Jaya<\/strong>. Máme je ve variantě <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=jaya\">do půlky lýtka<\/a> i pod koleno. A jestli jste extra zimomřiví, vyberte si variantu <strong>s kožíškem uvnitř<\/strong> <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=jaya+winter\">Jaya Winter<\/a>.<\/p>"}},"accor_item_aCan6z":{"type":"accor_item","settings":{"icon":"none","title":"Mám úzké lýtko. Jaké Ahinsa shoes mi sednou?","content":"<p>Na úzké lýtko sedí <strong>všechny Ahinsa shoes<\/strong>. Naše kozačky <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=jaya\">Jaya<\/a> si díky šněrování utáhnete podle sebe. A <a href=\"https:\/\/ahinsashoes.cz\/search?type=product%2Carticle&q=koza%C4%8Dky+neopren\">tyto klasické kozačky<\/a> obejmou i úzké lýtko díky neoprenu v zadní části.<\/p>"}},"accor_item_3iiaLG":{"type":"accor_item","settings":{"icon":"none","title":"Boty mi nesedí. Co mám dělat?","content":"<p><strong>Ozvěte se nám<\/strong>, boty vám bleskurychle vyměníme a zaplatíme poštovné. Podrobný postup najdete na <a href=\"https:\/\/ahinsashoes.cz\/pages\/refund-portal?_gl=1*q5hzo*_up*MQ..*_ga*ODY5NjYxMzEwLjE3MTYzODI5NDE.*_ga_CC68BHMH51*MTcyMTY1Njg3MS4xNDYuMC4xNzIxNjU2ODcxLjYwLjAuMA..&retino-portal-7d17-url=\/cs\/portal\/iframe\/c78ca2b1-952a-4538-9924-ce85e3b0fa12\/\">této stránce<\/a>. Pro jistotu jen upozorníme, že dokážeme vyměnit pouze boty, ve kterých jste <strong>nechodili venku <\/strong>a nenesou známky opotřebení. <\/p>"}},"accor_item_GdzPF6":{"type":"accor_item","settings":{"icon":"none","title":"Můžu si Ahinsa shoes někde vyzkoušet?","content":"<p>Můžete, budeme moc rádi. <strong>V Praze<\/strong> nás najdete přímo <a href=\"https:\/\/ahinsashoes.cz\/pages\/prodejna\">v centru na Londýnské 309\/81<\/a>. Jestli to k nám máte daleko, navštivte jednu z <a href=\"https:\/\/ahinsashoes.cz\/pages\/partnerske-prodejny\">partnerských prodejen<\/a> <strong>po celé republice<\/strong>.<\/p><p>A pro ty z vás, kdo nemáte poblíž ani partnerskou prodejnu, tu máme třetí možnost. Objednejte si Ahinsa shoes domů, vyzkoušejte je, a pokud vám nesednou, <strong>pošlete nám je zpátky<\/strong>. Zaplatíme poštovné a <a href=\"https:\/\/ahinsashoes.cz\/pages\/refund-portal\">bleskurychle vám pošleme správnou velikost nebo model<\/a>.<\/p>"}}},"block_order":["accor_item_CdJpWE","accor_item_jkrU7J","accor_item_UdexmU","accor_item_c6ADLP","accor_item_aCan6z","accor_item_3iiaLG","accor_item_GdzPF6"],"settings":{"design_heading":"1","heading_align":"t4s-text-center","top_heading":"Často se ptáte","icon_heading":"las la-gem","top_subheading":"","tophead_mb":30,"accor_des":"1","title_cl":"#202020","bg_title_cl":"#f6f6f8","title_active_cl":"#000000","bg_title_active_cl":"#f6f6f8","content_cl":"#202020","bg_content_cl":"#ffffff","content_align":"t4s-text-start","auto_active":true,"layout":"t4s-cus-width","custom_width":1000,"cl_bg":"","cl_bg_gradient":"","mg":",,50px,","pd":"","mg_tb":"","pd_tb":"","mg_mb":",,30px,","pd_mb":"","use_cus_css":false,"code_cus_css":""}}},"order":["heading","hero_image_Lx8jTN","main","sidebar-page","custom_liquid_mGdjig","custom_liquid_fay9Q8","image_text_Xn3CFe","image_text_UBTwQD","image_text_PytpnL","our_mission_qYpCAP","image_text_zePBDe","accordion_cwnV8p"]}