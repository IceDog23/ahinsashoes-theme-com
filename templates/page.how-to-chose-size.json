    "our_mission_qYpCAP": {
      "type": "our_mission",
      "blocks": {
        "om_item_AT8rXH": {
          "type": "om_item",
          "settings": {
            "heading": "Toe allowance",
            "content": "There must always be free space in front of the toes so the foot can move naturally. So don’t be alarmed if the shoes feel “bigger”.<br>\n<b>When you stand on tiptoe, there should be about a finger’s width of free space in front of your toes.<\/b>",
            "text_align": "start",
            "col_tb": "6",
            "col_mb": "6"
          }
        },
        "om_item_GanpAi": {
          "type": "om_item",
          "settings": {
            "heading": "Foot width and instep height",
            "content": "For every Ahinsa shoes model you’ll also find the width at the widest point and the instep circumference.<br>\n<b>If you know that shoes often feel tight, pay attention to these measurements.<\/b>",
            "text_align": "start",
            "col_tb": "6",
            "col_mb": "6"
          }
        }
      },
      "block_order": ["om_item_AT8rXH", "om_item_GanpAi"],
