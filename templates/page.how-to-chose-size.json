        },
        "bl_text_jwGehB": {
          "type": "bl_text",
          "settings": {
            "quote": false,
            "smaller_text": false,
            "col_dk": "6",
            "col_tb": "6",
            "text_size": "40,15",
            "txt_align": "start",
            "sub_heading": "",
            "heading": "How to try on shoes so they really fit?",
            "text": "<ol><li>Try them at home first. If the shoes don’t fit, you can <a href=\"https:\/\/ahinsashoes.cz\/pages\/refund-portal\" title=\"https:\/\/ahinsashoes.cz\/pages\/refund-portal\">exchange<\/a> them unworn.<br\/><br\/><\/li><li>Put on socks before you try them on.<br\/><br\/><\/li><li>Tie the laces.<br\/><br\/><\/li><li>Walk around in the new shoes, stand on tiptoe, have a little jump.<\/li><\/ol>",
            "subhd_color": "#202020",
            "hd_color": "#202020",
            "des_color": "#202020",
            "use_shadow": false,
            "button_label": "Button label",
