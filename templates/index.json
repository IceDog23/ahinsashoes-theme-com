        "ai_gen_block_db84391_AYJTkY": {
          "type": "ai_gen_block_db84391",
          "settings": {
            "main_heading": "Barefoot shoes or Comfort?",
            "subheading": "Choose shoes according to how you want to walk.",
            "supporting_text": "<p>Both lines share what matters most: a wide anatomical toe box, zero drop, and a design by physiotherapists. The main difference is how much you want to feel the ground beneath you.<\/p>",
            "barefoot_badge_text": "BAREFOOT",
            "barefoot_headline": "Natural walking, as if barefoot",
            "barefoot_text": "<p>A thin, flexible outsole lets you feel the terrain and actively engage your foot. <br\/>➡️ For anyone who wants the closest feeling to walking barefoot.<\/p>",
            "barefoot_image": "shopify:\/\/shop_images\/img_8172_62c2b241-dfdb-491e-a81b-605daca6ecb3.jpg",
            "barefoot_image_link": "https:\/\/ahinsashoes.cz\/collections\/all\/barefoot",
            "barefoot_benefit_1": "thin outsole: 2–5 mm",
            "barefoot_benefit_2": "maximum flexibility in every direction",
            "barefoot_benefit_3": "a clear sense of contact with the ground",
            "barefoot_helper_text": "<strong>Best for<\/strong>: lovers of natural movement and more experienced barefoot walkers.",
            "barefoot_button_text": "Barefoot shoes →",
            "barefoot_button_link": "https:\/\/ahinsashoes.cz\/collections\/all\/barefoot",
            "comfort_badge_text": "COMFORT",
            "comfort_headline": "Soft landing, barefoot principles",
            "comfort_text": "<p>An Ahinsa specialty: the benefits of barefoot with a cushioned landing.<br\/>➡️ Simply for anyone who wants comfort with every step, even in the city.<\/p>",
            "comfort_image": "shopify:\/\/shop_images\/ahinsa_098_35b4e80e-8b6f-4304-984d-20451107bf20.jpg",
            "comfort_image_link": "https:\/\/ahinsashoes.cz\/collections\/all\/comfort",
            "comfort_benefit_1": "wide toe box and zero drop",
            "comfort_benefit_2": "soft landings as you walk",
            "comfort_benefit_3": "comfort even on hard surfaces",
            "comfort_helper_text": "<strong>Best for<\/strong>: city walking, all-day wear, and barefoot beginners.",
            "comfort_button_text": "Comfort shoes →",
            "comfort_button_link": "https:\/\/ahinsashoes.cz\/collections\/all\/comfort",
            "bottom_note": "<p>Not sure? <strong>Start with the Comfort line<\/strong>. If you want the closest feeling to walking barefoot, <strong>choose Barefoot<\/strong>.<\/p>",
