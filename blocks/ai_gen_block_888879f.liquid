{% doc %}
  @prompt
    Create a new Shopify section for a “Last chance / low stock products” horizontal carousel.
    
    Design according to the attached reference:
    - Full-width boxed section with light beige/cream background
    - Thin golden/yellow border around the whole section
    - Header row:
      - Left side: small clock icon + title “Poslední šance – doprodej”
      - Right side: text “Omezené množství skladem”
    - Product cards underneath
    - Desktop: show 4 products in one row
    - Mobile: show 2 products in one row
    - Maximum 8 selectable products total
    - Layout must stay on one horizontal row with horizontal scrolling/swiping
    - No wrapping into multiple rows
    
    Product card design:
    - Product image at the top
    - Stock badge strip over/under image, e.g. “Zbývají 3 kusy” / “Zbývá 5 párů”
    - Product title
    - Size text, e.g. “vel. 42–43”
    - Sale price in highlighted red
    - Compare-at price next to it, smaller and crossed out
    - Whole card should link to the product page
    
    Shopify customizer settings:
    - Enable/disable section
    - Section title
    - Right-side subtitle
    - Icon enable/disable
    - Background color
    - Border color
    - Text colors
    - Badge background color
    - Badge text color
    - Sale price color
    - Select up to 8 products manually
    - For each product, allow custom stock badge text and custom size text
    
    Technical requirements:
    - Use Liquid, CSS and vanilla JavaScript only
    - No external libraries
    - Responsive and swipe-friendly on mobile
    - Add scroll-snap behavior
    - Hide scrollbar visually if possible, but keep scrolling functional
    - Create full Shopify section code including schema
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-last-chance-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    padding: {{ block.settings.section_padding }}px;
    margin: {{ block.settings.section_margin }}px 0;
  }

  .ai-last-chance-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ai-last-chance-title-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-last-chance-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-last-chance-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-last-chance-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-last-chance-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-last-chance-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-last-chance-carousel-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 10px;
  }

  .ai-last-chance-carousel-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-last-chance-product-card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.product_gap }}px * 3)) / 4);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .ai-last-chance-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-last-chance-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: {{ block.settings.image_bg_color }};
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-last-chance-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-last-chance-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-last-chance-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-last-chance-stock-badge-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    text-align: center;
    padding: 8px 10px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: {{ block.settings.badge_font_weight }};
  }

  .ai-last-chance-product-info-{{ ai_gen_id }} {
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-last-chance-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    line-height: 1.3;
    font-weight: {{ block.settings.product_title_weight }};
  }

  .ai-last-chance-product-size-{{ ai_gen_id }} {
    font-size: {{ block.settings.size_text_size }}px;
    color: {{ block.settings.size_text_color }};
    margin: 0;
  }

  .ai-last-chance-price-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-last-chance-sale-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.sale_price_size }}px;
    color: {{ block.settings.sale_price_color }};
    font-weight: {{ block.settings.sale_price_weight }};
    margin: 0;
  }

  .ai-last-chance-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_price_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-last-chance-product-card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.product_gap }}px) / 2);
    }

    .ai-last-chance-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .ai-last-chance-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.85);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-last-chance-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px;
    }

    .ai-last-chance-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.8);
      height: calc({{ block.settings.icon_size }}px * 0.8);
    }
  }
{% endstyle %}

{% if block.settings.enable_section %}
  <ai-last-chance-{{ ai_gen_id }}
    class="ai-last-chance-section-{{ ai_gen_id }}"
    {{ block.shopify_attributes }}
  >
    <div class="ai-last-chance-header-{{ ai_gen_id }}">
      <div class="ai-last-chance-title-wrapper-{{ ai_gen_id }}">
        {% if block.settings.show_icon %}
          <div class="ai-last-chance-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.2 3.2.8-1.3-4.5-2.7V7z"/>
            </svg>
          </div>
        {% endif %}
        {% if block.settings.section_title != blank %}
          <h2 class="ai-last-chance-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
      </div>
      {% if block.settings.section_subtitle != blank %}
        <p class="ai-last-chance-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
      {% endif %}
    </div>

    <div class="ai-last-chance-carousel-wrapper-{{ ai_gen_id }}">
      <div class="ai-last-chance-carousel-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% assign product_key = 'product_' | append: i %}
          {% assign stock_badge_key = 'stock_badge_' | append: i %}
          {% assign size_text_key = 'size_text_' | append: i %}
          
          {% assign product = block.settings[product_key] %}
          {% assign stock_badge = block.settings[stock_badge_key] %}
          {% assign size_text = block.settings[size_text_key] %}

          {% if product != blank %}
            <a
              href="{{ product.url }}"
              class="ai-last-chance-product-card-{{ ai_gen_id }}"
            >
              <div class="ai-last-chance-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-last-chance-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-last-chance-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if stock_badge != blank %}
                  <div class="ai-last-chance-stock-badge-{{ ai_gen_id }}">
                    {{ stock_badge }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-last-chance-product-info-{{ ai_gen_id }}">
                <h3 class="ai-last-chance-product-title-{{ ai_gen_id }}">
                  {{ product.title }}
                </h3>

                {% if size_text != blank %}
                  <p class="ai-last-chance-product-size-{{ ai_gen_id }}">
                    {{ size_text }}
                  </p>
                {% endif %}

                <div class="ai-last-chance-price-wrapper-{{ ai_gen_id }}">
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-last-chance-sale-price-{{ ai_gen_id }}">
                      {{ product.price | money }}
                    </span>
                    <span class="ai-last-chance-compare-price-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% else %}
                    <span class="ai-last-chance-sale-price-{{ ai_gen_id }}">
                      {{ product.price | money }}
                    </span>
                  {% endif %}
                </div>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </ai-last-chance-{{ ai_gen_id }}>

  <script>
    (function() {
      class AiLastChance{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
        }

        connectedCallback() {
          this.carousel = this.querySelector('.ai-last-chance-carousel-{{ ai_gen_id }}');
          
          if (this.carousel) {
            this.enableTouchScroll();
          }
        }

        enableTouchScroll() {
          let isDown = false;
          let startX;
          let scrollLeft;

          this.carousel.addEventListener('mousedown', (e) => {
            isDown = true;
            this.carousel.style.cursor = 'grabbing';
            startX = e.pageX - this.carousel.offsetLeft;
            scrollLeft = this.carousel.scrollLeft;
          });

          this.carousel.addEventListener('mouseleave', () => {
            isDown = false;
            this.carousel.style.cursor = 'grab';
          });

          this.carousel.addEventListener('mouseup', () => {
            isDown = false;
            this.carousel.style.cursor = 'grab';
          });

          this.carousel.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - this.carousel.offsetLeft;
            const walk = (x - startX) * 2;
            this.carousel.scrollLeft = scrollLeft - walk;
          });

          this.carousel.style.cursor = 'grab';
        }
      }

      customElements.define('ai-last-chance-{{ ai_gen_id }}', AiLastChance{{ ai_gen_id }});
    })();
  </script>
{% endif %}

