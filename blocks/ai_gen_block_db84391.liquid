            <li class="ai-comparison-benefit-item-{{ ai_gen_id }}">
              <span class="ai-comparison-benefit-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
              </span>
              <span>{{ block.settings.barefoot_benefit_1 }}</span>
            </li>
          {% endif %}

          {% if block.settings.barefoot_benefit_2 != blank %}
            <li class="ai-comparison-benefit-item-{{ ai_gen_id }}">
              <span class="ai-comparison-benefit-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
              </span>
              <span>{{ block.settings.barefoot_benefit_2 }}</span>
            </li>
          {% endif %}

          {% if block.settings.barefoot_benefit_3 != blank %}
            <li class="ai-comparison-benefit-item-{{ ai_gen_id }}">
              <span class="ai-comparison-benefit-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
              </span>
              <span>{{ block.settings.barefoot_benefit_3 }}</span>
            </li>
          {% endif %}
        </ul>

        {% if block.settings.barefoot_helper_text != blank %}
          <div class="ai-comparison-helper-text-{{ ai_gen_id }}">{{ block.settings.barefoot_helper_text }}</div>
        {% endif %}

        {% if block.settings.barefoot_button_text != blank %}
          <a
            href="{{ block.settings.barefoot_button_link }}"
            class="ai-comparison-cta-button-{{ ai_gen_id }}"
          >
            {{ block.settings.barefoot_button_text }}
          </a>
        {% endif %}
      </div>

      <div class="ai-comparison-card-{{ ai_gen_id }} ai-comparison-card-comfort-{{ ai_gen_id }}">
        <div class="ai-comparison-badge-{{ ai_gen_id }}">
          <span class="ai-comparison-badge-dot-{{ ai_gen_id }}"></span>
          <span>{{ block.settings.comfort_badge_text }}</span>
        </div>

        {% if block.settings.comfort_headline != blank %}
          <h3 class="ai-comparison-card-headline-{{ ai_gen_id }}">{{ block.settings.comfort_headline }}</h3>
        {% endif %}

        {% if block.settings.comfort_text != blank %}
          <div class="ai-comparison-card-text-{{ ai_gen_id }}">{{ block.settings.comfort_text }}</div>
        {% endif %}

        {% if block.settings.comfort_image_link != blank %}
          <a href="{{ block.settings.comfort_image_link }}" class="ai-comparison-image-link-{{ ai_gen_id }}">
        {% endif %}
        {% if block.settings.comfort_image %}
          <div class="ai-comparison-image-container-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.comfort_image | image_url: width: 800 }}"
              alt="{{ block.settings.comfort_image.alt | escape }}"
