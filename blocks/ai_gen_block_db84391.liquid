              height="{{ block.settings.comfort_image.height }}"
            >
          </div>
        {% else %}
          <div class="ai-comparison-image-container-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings.comfort_image_link != blank %}
          </a>
        {% endif %}

        <ul class="ai-comparison-benefits-{{ ai_gen_id }}">
          {% if block.settings.comfort_benefit_1 != blank %}
            <li class="ai-comparison-benefit-item-{{ ai_gen_id }}">
              <span class="ai-comparison-benefit-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
              </span>
              <span>{{ block.settings.comfort_benefit_1 }}</span>
            </li>
          {% endif %}

          {% if block.settings.comfort_benefit_2 != blank %}
            <li class="ai-comparison-benefit-item-{{ ai_gen_id }}">
              <span class="ai-comparison-benefit-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
              </span>
              <span>{{ block.settings.comfort_benefit_2 }}</span>
            </li>
          {% endif %}

          {% if block.settings.comfort_benefit_3 != blank %}
            <li class="ai-comparison-benefit-item-{{ ai_gen_id }}">
              <span class="ai-comparison-benefit-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
              </span>
              <span>{{ block.settings.comfort_benefit_3 }}</span>
            </li>
          {% endif %}
        </ul>

        {% if block.settings.comfort_helper_text != blank %}
          <div class="ai-comparison-helper-text-{{ ai_gen_id }}">{{ block.settings.comfort_helper_text }}</div>
        {% endif %}

        {% if block.settings.comfort_button_text != blank %}
          <a
            href="{{ block.settings.comfort_button_link }}"
            class="ai-comparison-cta-button-{{ ai_gen_id }}"
          >
            {{ block.settings.comfort_button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    {% if block.settings.bottom_note != blank %}
      <div class="ai-comparison-bottom-note-{{ ai_gen_id }}">{{ block.settings.bottom_note }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Barefoot vs Comfort",
  "settings": [
    {
      "type": "header",
      "content": "Section intro"
    },
    {
      "type": "inline_richtext",
      "id": "main_heading",
      "label": "Main heading",
      "default": "Barefoot nebo Comfort?"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Vyberte si boty podle toho, jak chcete chodit."
    },
    {
      "type": "richtext",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "<p>Obě řady spojuje to nejdůležitější: anatomicky prostorná špička, nulový podpatek a návrh od fyzioterapeutů. Rozdíl je hlavně v tom, jak moc chcete cítit zem pod sebou.</p>"
    },
    {
      "type": "header",
      "content": "Barefoot card"
    },
    {
      "type": "text",
      "id": "barefoot_badge_text",
      "label": "Badge text",
      "default": "BAREFOOT"
    },
    {
      "type": "inline_richtext",
      "id": "barefoot_headline",
      "label": "Headline",
      "default": "Přirozená chůze"
    },
    {
      "type": "richtext",
      "id": "barefoot_text",
      "label": "Description",
      "default": "<p>Tenká a flexibilní podrážka vám nechá vnímat terén a aktivně zapojit chodidlo. Pro ty, kdo chtějí co nejbližší pocit chůze naboso.</p>"
    },
    {
      "type": "image_picker",
      "id": "barefoot_image",
      "label": "Product image"
    },
     {
      "type": "url",
      "id": "barefoot_image_link",
      "label": "Image link"
    },
    {
      "type": "text",
      "id": "barefoot_benefit_1",
      "label": "Benefit 1",
      "default": "tenká podrážka 2–5 mm"
    },
    {
      "type": "text",
