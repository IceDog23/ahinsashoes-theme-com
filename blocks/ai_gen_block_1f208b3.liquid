      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background",
      "default": "#d4a574"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Badge font size",
      "min": 10,
